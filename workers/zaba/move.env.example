# Zaba Scraper Service — copy to .env and fill in values

# Token the edge function uses to authenticate requests to this service
ZABA_SERVICE_TOKEN=your-secret-token-here

# FlameProxies — PRIMARY fetch path (curl --proxy). Same account/package as fps-playwright.
FLAMEPROXIES_API_KEY=your-flameproxies-api-key
FLAMEPROXIES_PACKAGE_ID=2549

# How many Flame IPs to try per URL (default 5; ~40% success per IP in A/B)
# ZABA_PROXY_ATTEMPTS=5

# LAST RESORT only: host residential IP via curl after all Flame attempts fail.
# Enterprise/prod: keep OFF (unset/0) to never burn personal IP.
# Home lab / debug: set "1" so scrapes can succeed when proxies are down.
# ZABA_DIRECT_FALLBACK=0
