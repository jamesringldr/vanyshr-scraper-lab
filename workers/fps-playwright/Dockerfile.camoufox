# Camoufox runner for the FPS smoke test.
# Base on the Playwright noble image: it already carries the system libs that
# Firefox/Camoufox need. We add Python, pip, Xvfb (for headless="virtual"),
# Camoufox, and pre-fetch the Camoufox browser binary so runtime starts fast.
FROM mcr.microsoft.com/playwright:v1.61.1-noble

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_BREAK_SYSTEM_PACKAGES=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip xvfb ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# camoufox[geoip] pulls the geoip db used to align timezone/locale to a proxy IP.
RUN pip3 install --no-cache-dir "camoufox[geoip]"

# Pre-download the Camoufox Firefox build into the image.
RUN python3 -m camoufox fetch

WORKDIR /app
COPY smoke.py /app/smoke.py

ENV OUT_DIR=/out
ENTRYPOINT ["python3", "smoke.py"]
