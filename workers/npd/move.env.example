# NPD Scraper Service — copy to .env and fill in values

# Token scrape_runner / callers use to auth against this service
NPD_SERVICE_TOKEN=your-secret-token-here

# Port (FPS=8787, Zaba=8788, NPD=8789)
# NPD_PORT=8789

# Fetch route (Phase 0): direct curl on serv01 is primary.
# Flame scored 0/5 (403) for NPD on 2026-08-07 — leave off unless re-probed.
# NPD_USE_FLAME=0
# NPD_PROXY_ATTEMPTS=3

# FlameProxies (optional; same account/package as FPS/Zaba) — only if NPD_USE_FLAME=1
FLAMEPROXIES_API_KEY=your-flameproxies-api-key
FLAMEPROXIES_PACKAGE_ID=2549
